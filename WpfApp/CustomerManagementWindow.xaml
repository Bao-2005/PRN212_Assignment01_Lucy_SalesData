<Window x:Class="DoQuocBaoWPF.CustomerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoQuocBaoWPF"
        mc:Ignorable="d"
        Title="CustomerManagementWindow" Height="450" Width="800">

    <Grid>
        <ListView x:Name="lvCustomer" Height="200" VerticalAlignment="Top" SelectionChanged="lvCustomer_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Customer ID" DisplayMemberBinding="{Binding CustomerID}"/>
                    <GridViewColumn Header="Company Name" DisplayMemberBinding="{Binding CompanyName}"/>
                    <GridViewColumn Header="Contact Name" DisplayMemberBinding="{Binding ContactName}"/>
                    <GridViewColumn Header="Contact Title" DisplayMemberBinding="{Binding ContactTitle}"/>
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}"/>
                    <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding Phone}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Content="Customer ID" Margin="10,205,714,198" RenderTransformOrigin="0.526,0.852"/>
        <Label Content="Company Name" Margin="10,236,680,167" RenderTransformOrigin="0.497,0.22"/>
        <Label Content="Contact Name" Margin="10,267,690,136"/>
        <Label Content="Contact Title" Margin="10,298,690,105"/>
        <Label Content="Address" Margin="10,329,690,74"/>
        <Label Content="Phone" Margin="10,360,690,43"/>

        <TextBlock x:Name="txtCustomerID" HorizontalAlignment="Left" Margin="149,211,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCompanyName" HorizontalAlignment="Left" Margin="149,241,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtContactName" HorizontalAlignment="Left" Margin="149,274,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtContactTitle" HorizontalAlignment="Left" Margin="149,303,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtAddress" HorizontalAlignment="Left" Margin="149,334,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtPhone" HorizontalAlignment="Left" Margin="149,365,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <Button x:Name="btnSaveCustomer" Content="Add new customer" HorizontalAlignment="Left" Margin="293,404,0,0" VerticalAlignment="Top" Click="btnSaveCustomer_Click"/>
        <Button x:Name="btnUpdateCustomer" Content="Update customer" HorizontalAlignment="Left" Margin="445,404,0,0" VerticalAlignment="Top" Click="btnUpdateCustomer_Click"/>
        <Button x:Name="btnDeleteCustomer" Content="Delete customer" HorizontalAlignment="Left" Margin="589,404,0,0" VerticalAlignment="Top" Click="btnDeleteCustomer_Click"/>

    </Grid>
</Window>

<Window x:Class="DoQuocBaoWPF.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoQuocBaoWPF"
        mc:Ignorable="d"
        Title="EmployeeWindow" Height="450" Width="800">
    <Grid>
        <Label Content="EmployeeID" Margin="21,19,703,384" />
        <Label Content="Name" Margin="21,50,703,353" />
        <Label Content="Username" Margin="21,81,703,322" />
        <Label Content="Password" Margin="21,112,703,291" />
        <Label Content="Job Title" Margin="21,144,703,259" />
        <Label Content="Birth Date" Margin="21,175,703,228" />
        <Label Content="Hire Date" Margin="21,207,703,196" />
        <Label Content="Address" Margin="21,239,703,164" />

        <TextBlock x:Name="txtEmployeeID" HorizontalAlignment="Left" Margin="160,25,0,0"
               TextWrapping="Wrap" Text="ID" VerticalAlignment="Top" />
        <TextBox x:Name="txtName" Margin="160,55,0,0" Width="531" VerticalAlignment="Top" />
        <TextBox x:Name="txtUserName" Margin="160,88,0,0" Width="531" VerticalAlignment="Top" />
        <TextBox x:Name="txtPassword" Margin="160,117,0,0" Width="531" VerticalAlignment="Top" />
        <TextBox x:Name="txtJobTitle" Margin="160,148,0,0" Width="531" VerticalAlignment="Top" />
        <TextBox x:Name="txtBirthDate" Margin="214,182,54,0" Width="531" VerticalAlignment="Top" />
        <TextBox x:Name="txtHireDate" Margin="214,214,54,0" Width="531" VerticalAlignment="Top" />
        <TextBox x:Name="txtAddress" Margin="160,243,0,0" Width="531" VerticalAlignment="Top" />
    </Grid>
</Window>

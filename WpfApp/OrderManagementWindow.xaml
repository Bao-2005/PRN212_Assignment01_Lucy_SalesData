<Window x:Class="DoQuocBaoWPF.OrderManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoQuocBaoWPF"
        mc:Ignorable="d"
        Title="OrderManagementWindow" Height="900" Width="800">
    <Grid>
        <ListView x:Name="lvOrder" Height="200" VerticalAlignment="Top" SelectionChanged="lvOrder_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="OrderID" DisplayMemberBinding="{Binding OrderID}"/>
                    <GridViewColumn Header="CustomerID" DisplayMemberBinding="{Binding CustomerID}"/>
                    <GridViewColumn Header="EmployeeID" DisplayMemberBinding="{Binding EmployeeID}"/>
                    <GridViewColumn Header="OrderDate" DisplayMemberBinding="{Binding OrderDate}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ListView x:Name="lvOrderDetails" Height="200" VerticalAlignment="Top" Margin="0,200,0,0" SelectionChanged="lvOrderDetails_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="OrderID" DisplayMemberBinding="{Binding OrderID}"/>
                    <GridViewColumn Header="ProductID" DisplayMemberBinding="{Binding ProductID}"/>
                    <GridViewColumn Header="UnitPrice" DisplayMemberBinding="{Binding UnitPrice}"/>
                    <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Discount" DisplayMemberBinding="{Binding Discount}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Label Content="OrderID" Margin="14,419,710,-16" RenderTransformOrigin="0.526,0.852"/>
        <Label Content="CustomerID" Margin="14,450,676,-47" RenderTransformOrigin="0.497,0.22"/>
        <Label Content="EmployeeID" Margin="14,481,686,-78"/>
        <Label Content="OrderDate" Margin="14,512,686,-109"/>
        <Label Content="Discount" Margin="14,546,686,-143"/>
        <Label Content="ProductID" Margin="14,581,686,-178"/>
        <Label Content="Quantity" Margin="14,613,686,-210"/>
        <TextBlock x:Name="txtOrderID" HorizontalAlignment="Left" Margin="153,425,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCustomerID" HorizontalAlignment="Left" Margin="153,455,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtEmployeeID" HorizontalAlignment="Left" Margin="153,488,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <DatePicker x:Name="txtOrderDate" HorizontalAlignment="Left" Margin="153,517,0,0" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtDiscount" HorizontalAlignment="Left" Margin="153,550,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtProductID" HorizontalAlignment="Left" Margin="153,581,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtQuantity" HorizontalAlignment="Left" Margin="153,617,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <Button x:Name="btnSaveOrder" Content="Add new order" HorizontalAlignment="Left" Margin="223,681,0,0" VerticalAlignment="Top" Click="btnSaveOrder_Click"/>
        <Button x:Name="btnViewEmployee" Content="View employee" HorizontalAlignment="Left" Margin="376,681,0,0" VerticalAlignment="Top" Click="btnViewEmployee_Click"/>
        <Button x:Name="btnViewProduct" Content="View product" HorizontalAlignment="Left" Margin="537,681,0,0" VerticalAlignment="Top" Click="btnViewProduct_Click"/>

    </Grid>
</Window>

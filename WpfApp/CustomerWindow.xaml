<Window x:Class="DoQuocBaoWPF.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoQuocBaoWPF"
        mc:Ignorable="d"
        Title="CustomerWindow" Height="500" Width="800">
    <Grid>
        <ListView x:Name="lvOldOrder" d:ItemsSource="{d:SampleData ItemCount=5}" Height="206" VerticalAlignment="Top">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="OrderID" DisplayMemberBinding="{Binding OrderID}"/>
                    <GridViewColumn Header="CustomerID" DisplayMemberBinding="{Binding CustomerID}"/>
                    <GridViewColumn Header="EmployeeID" DisplayMemberBinding="{Binding EmployeeID}"/>
                    <GridViewColumn Header="OrderDate" DisplayMemberBinding="{Binding OrderDate}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Label Content="Customer ID" Margin="66,236,658,167" RenderTransformOrigin="0.526,0.852"/>
        <Label Content="Company Name" Margin="66,267,624,136" RenderTransformOrigin="0.497,0.22"/>
        <Label Content="Contact Name" Margin="66,298,634,105"/>
        <Label Content="Contact Title" Margin="66,329,634,74"/>
        <Label Content="Address" Margin="66,360,634,43"/>
        <Label Content="Phone" Margin="66,391,634,12"/>
        <Label Content="Search" Margin="66,432,634,-29"/>

        <TextBlock x:Name="txtCustomerID" HorizontalAlignment="Left" Margin="205,242,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCompanyName" HorizontalAlignment="Left" Margin="205,272,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtContactName" HorizontalAlignment="Left" Margin="205,305,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtContactTitle" HorizontalAlignment="Left" Margin="205,334,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtAddress" HorizontalAlignment="Left" Margin="205,365,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtPhone" HorizontalAlignment="Left" Margin="205,396,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="531"/>
        <TextBox x:Name="txtSearch" HorizontalAlignment="Left" Margin="166,436,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="167"/>
        <Button x:Name="btnUpdateCustomer" Content="Update Profile" HorizontalAlignment="Left" Margin="501,435,0,0" VerticalAlignment="Top" Click="btnUpdateCustomer_Click"/>
        <Button x:Name="btnSaveCustomer" Content="Create account" HorizontalAlignment="Left" Margin="400,436,0,0" VerticalAlignment="Top" Click="btnSaveCustomer_Click" RenderTransformOrigin="0.747,1.609"/>
        <Button x:Name="btnDeleteCustomer" Content="Delete account" HorizontalAlignment="Left" Margin="598,435,0,0" VerticalAlignment="Top" Click="btnDeleteCustomer_Click"/>
        <Button x:Name="btnConfirm" Content="Confirm" HorizontalAlignment="Left" Margin="264,459,0,0" VerticalAlignment="Top" Click="btnConfirm_Click"/>

    </Grid>
</Window>
